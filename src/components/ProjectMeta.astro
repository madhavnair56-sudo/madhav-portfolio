---
interface Props {
  role: string;
  period?: string;
  team: string[];
  tags: string[];
}
const { role, period, team, tags } = Astro.props;
const items = [
  ['Role', role],
  ['Period', period],
  ['Team', team.join(' · ')],
  ['Focus', tags.join(' · ')]
].filter(([, value]) => Boolean(value));
---
<dl class="meta-grid">
  {items.map(([label, value]) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>
<style>
  .meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; border-top: 1px solid var(--line); padding-top: 1.25rem; margin: 3rem 0 0; }
  dt { color: var(--muted); font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  dd { margin: .5rem 0 0; font-size: .95rem; }
  @media (max-width: 800px) { .meta-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
