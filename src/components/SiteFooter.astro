---
import { siteConfig } from '../site.config';
const year = new Date().getFullYear();
---
<footer>
  <div class="container footer-grid">
    <div>
      <p class="footer-title">{siteConfig.name}</p>
      <p class="muted">Content design · Product content · Product communication</p>
    </div>
    <div class="footer-links">
      {siteConfig.email && <a href={`mailto:${siteConfig.email}`}>Email</a>}
      {siteConfig.linkedin && <a href={siteConfig.linkedin}>LinkedIn</a>}
      <span>© {year}</span>
    </div>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); padding: 2rem 0 3rem; margin-top: 4rem; }
  .footer-grid { display: flex; justify-content: space-between; gap: 2rem; align-items: flex-end; }
  p { margin: 0; }
  .footer-title { font-weight: 600; }
  .muted { margin-top: .25rem; color: var(--muted); font-size: .9rem; }
  .footer-links { display: flex; gap: 1rem; color: var(--muted); font-size: .9rem; }
  @media (max-width: 700px) { .footer-grid { display: grid; } }
</style>
